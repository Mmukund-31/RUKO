# Copy to backend/.env and fill in. Never commit .env.
# Create a key at https://app.gnani.ai/voice/api-keys
GNANI_API_KEY=your-gnani-api-key-here

# Optional overrides (defaults shown)
GNANI_BASE_URL=https://api.vachana.ai
PRISMA_MODEL=prisma-v3.0
PRISMA_FORMAT=codemix
TIMBRE_MODEL=timbre-v3.0
# A Timbre v3.0 voice (speaks all 10 languages): Lakshmi, Shivani, Kalpana, Avinash, ...
TIMBRE_VOICE=Lakshmi
TIMBRE_SPEED=0.95
HTTP_TIMEOUT_S=30
